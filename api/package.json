{
  "name": "chatapp-api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + TypeScript + TypeORM API for the exam project chat app",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10.9 <11"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js -d src/db/admin-data-source.ts migration:generate",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:run": "tsx ./node_modules/typeorm/cli.js -d src/db/admin-data-source.ts migration:run",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js -d src/db/admin-data-source.ts migration:revert",
    "migration:show": "tsx ./node_modules/typeorm/cli.js -d src/db/admin-data-source.ts migration:show",
    "migration:run:prod": "typeorm -d dist/db/admin-data-source.js migration:run",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/typeorm": "^12.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
