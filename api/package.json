{
  "name": "chatapp-api",
  "version": "0.1.0",
  "private": true,
  "description": "Express + TypeScript + TypeORM API for the exam project chat app",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "migration:generate": "typeorm-ts-node-commonjs -d src/db/admin-data-source.ts migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs -d src/db/admin-data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/db/admin-data-source.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d src/db/admin-data-source.ts migration:show",
    "migration:run:prod": "typeorm -d dist/db/admin-data-source.js migration:run",
    "seed": "ts-node src/db/seed.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
