# Copy this file to .env and fill in your own values.
# .env must never be committed to Git.

# Password for the postgres superuser in the Docker container
POSTGRES_PASSWORD=change_me_postgres

# chat_admin: owns the schema, runs migrations and the seed
DB_ADMIN_PASSWORD=change_me_admin

# chat_app: used by the API, data only
DB_APP_PASSWORD=change_me_app

# Used when running the API or npm scripts on your own computer (outside Docker)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=chatapp
